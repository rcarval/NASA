public class NAV_WebWS_Ticket_Helper {
    
    public String[] tickets{get;set;}

    public NAV_WebWS_Ticket_Helper() {
        tickets = new List<String>();
    }
    public void ticketReal(String uuid){
        List<Reserva__c> res = [SELECT Id, Empresa_Puelche__c
                                FROM Reserva__c
                                WHERE UUID__c =: uuid];
        if(res.size() > 0){
            for(Reserva__c rData : res){
                String b64 = '';
                PageReference pdfTicket ;
                if(rData.Empresa_Puelche__c == false){
                    pdfTicket= Page.NAV_TicketPDF;
                }else{
                    pdfTicket = Page.PUE_TicketPDF;
                }    
                
                pdfTicket.getParameters().put('id', rData.Id);
                if(!Test.isRunningTest()){
                    b64 = EncodingUtil.base64Encode(pdfTicket.getContent());
                }else{
                    b64 = 'datoEnBase64';
                }
                tickets.add(b64);
            }
        }
    }
    public void ticketFalso(){
        String b64 = '';
        b64 = '';
        tickets.add(b64);
    }
}