                function validaCarga(){
                    itinerario = localStorage.getItem("itinerario");
                    origen = localStorage.getItem("origen");
                    destino = localStorage.getItem("destino");
                    var cargas = parseFloat(localStorage.getItem("nCargas"));
                    if(cargas > 0){
                        //Datos de carga
                        var cCargaEDoc = '';
                        var cCargaENDo = '';
                        var cCargaENam = '';
                        var cCargaEApe = '';
                        var cCargaETel = '';
                        var cCargaRDoc = '';
                        var cCargaRNDo = '';
                        var cCargaRNam = '';
                        var cCargaRApe = '';
                        var cCargaRTel = '';
                        var cCargaObse = '';
                        if(!$('#ce_rut').is(':checked') && !$('#ce_pasa').is(':checked')){
                            alert("Debes seleccionar si la persona que entrega presenta rut o pasaporte");
                            terminaEspera();
                            return;
                        }else{
                            if($('#ce_rut').is(':checked')){
                                cCargaEDoc = 'RUT';
                            }else if($('#ce_pasa').is(':checked')){
                                cCargaEDoc = 'Pasaporte';
                            }
                        }
                        if($('#ce_documento').val() != ''){
                            cCargaENDo = $('#ce_documento').val();
                        }else{
                            alert("Debes ingresar el número de documento de la persona que entrega");
                            terminaEspera();
                            return;
                        }
                        if($('#ce_nombre').val() != ''){
                            cCargaENam = $('#ce_nombre').val();
                        }else{
                            alert("Debes ingresar el nombre de la persona que entrega");
                            terminaEspera();
                            return;
                        }
                        if($('#ce_apellido').val() != ''){
                            cCargaEApe = $('#ce_apellido').val();
                        }else{
                            alert("Debes ingresar el apellido de la persona que entrega");
                            terminaEspera();
                            return;
                        }
                        if($('#ce_telefono').val() != ''){
                            cCargaETel = $('#ce_telefono').val();
                            if(!Fn.validaTelefono(cCargaETel)){
                                alert("Debes ingresar un teléfono válido para la persona que entrega");
                                terminaEspera();
                                return;
                            }
                        }else{
                            alert("Debes ingresar el teléfono de la persona que entrega");
                            terminaEspera();
                            return;
                        }
                        if(!$('#cr_rut').is(':checked') && !$('#cr_pasa').is(':checked')){
                            alert("Debes seleccionar si la persona que retira presenta rut o pasaporte");
                            terminaEspera();
                            return;
                        }else{
                            if($('#cr_rut').is(':checked')){
                                cCargaRDoc = 'RUT';
                            }else if($('#cr_pasa').is(':checked')){
                                cCargaRDoc = 'Pasaporte';
                            }
                        }
                        if($('#cr_documento').val() != ''){
                            cCargaRNDo = $('#cr_documento').val();
                        }else{
                            alert("Debes ingresar el número de documento de la persona que recibe");
                            terminaEspera();
                            return;
                        }
                        if($('#cr_nombre').val() != ''){
                            cCargaRNam = $('#cr_nombre').val();
                        }else{
                            alert("Debes ingresar el nombre de la persona que recibe");
                            terminaEspera();
                            return;
                        }
                        if($('#cr_apellido').val() != ''){
                            cCargaRApe = $('#cr_apellido').val();
                        }else{
                            alert("Debes ingresar el apellido de la persona que recibe");
                            terminaEspera();
                            return;
                        }
                        if($('#cr_telefono').val() != ''){
                            cCargaRTel = $('#cr_telefono').val();
                            if(!Fn.validaTelefono(cCargaRTel)){
                                alert("Debes ingresar un teléfono válido para la persona que recibe");
                                terminaEspera();
                                return;
                            }
                        }else{
                            alert("Debes ingresar el teléfono de la persona que recibe");
                            terminaEspera();
                            return;
                        }
                        if($('#c_observaciones').val() != ''){
                            cCargaObse = $('#c_observaciones').val();
                        }
                        $.ajax({
                            type: "POST",
                            url: '/apex/NAV_ReservasDestinos?core.apexpages.devmode.url=0&pa=5&uuid='+uuid+'&i='+itinerario+'&o='+origen+'&d='+destino+'&carga='+cargas+'&cEDoc='+cCargaEDoc+'&cENdo='+cCargaENDo+'&cENam='+cCargaENam+'&cEApe='+cCargaEApe+'&cETel='+cCargaETel+'&cRDoc='+cCargaRDoc+'&cRNdo='+cCargaRNDo+'&cRNam='+cCargaRNam+'&cRApe='+cCargaRApe+'&cRTel='+cCargaRTel+'&cObse='+cCargaObse,
                            dataType: "jsonp"
                        }).complete(function (response) {
                            var data = JSON.parse(response.responseText);
                            console.log(data);
                            if(typeof data.estado != 'undefined'){
                                if(!data.estado){
                                    localStorage.removeItem("arrButa");
