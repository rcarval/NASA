                                loadResumen(uuid);
                                $("#menu_6").removeClass( "slds-is-current" ).addClass( "slds-is-complete" );
                                $("#menu_7").removeClass( "slds-is-active" ).addClass( "slds-is-current" );
                                $("#path-6").prop("aria-selected","true");
                                $("#paso6").hide();
                                $("#paso7").show();
                            }
                        });
                    }
                }
                function loadResumen(uuid){
                    setTimeout(function () {
                        $.ajax({
                            type: "POST",
                            url: '/apex/NAV_ReservasDestinos?core.apexpages.devmode.url=0&pa=6&uuid='+uuid,
                            dataType: "jsonp"
                        }).complete(function (response) {
                            var data = JSON.parse(response.responseText);
                            showResume(data);
                        });
                    }, 2000);
                }
                function minutesToString(minutes) {
                    var hour = Math.floor(minutes / 60);
                    hour = (hour < 10)? '0' + hour : hour;
                    var minute = Math.floor((minutes) % 60);
                    minute = (minute < 10)? '0' + minute : minute;
                    return hour + ' Hrs. ' + minute + ' Min.';
                }
