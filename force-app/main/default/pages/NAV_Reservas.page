                    dataType: "jsonp"
                }).complete(function (response) {
                    $("#v"+index+"_model").empty();
                    var data = JSON.parse(response.responseText);
                    $(data.modelos).each(function (i, item) {
                        $("#v"+index+"_model").append($('<option>', {
                            value: item.largo,
                            text : item.nombre,
                            nombre: item.nombre,
                            alto: item.alto,
                            largo: item.largo,
                            tipoMaestro: item.tipoMaestro
