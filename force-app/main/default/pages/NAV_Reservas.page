            var Fn = {
                // Valida el rut con su cadena completa "XXXXXXXX-X"
                validaRut : function (rutCompleto) {
                    if (!/^[0-9]+[-|‐]{1}[0-9kK]{1}$/.test( rutCompleto ))
                        return false;
                    var tmp     = rutCompleto.split('-');
                    var digv    = tmp[1];
                    var rut     = tmp[0];
                    if ( digv == 'K' ) digv = 'k' ;
                    return (Fn.dv(rut) == digv );
                },
                dv : function(T){
                    var M=0,S=1;
                    for(;T;T=Math.floor(T/10))
                        S=(S+T%10*(9-M++%6))%11;
                    return S?S-1:'k';
                },
                validaEmail : function(emailCompleto){
                    var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,6})?$/;
                    console.log('validando correo');
                    console.log((emailCompleto.length > 0 && emailReg.test( emailCompleto )));
                    return (emailCompleto.length > 0 && emailReg.test( emailCompleto ));
                },
                validaTelefono : function(telefonoCompleto){
                    var telefonoReg = /^(\+?56){1}(\s?)([2-9]{1})([0-9]\d{7})$/;
                    console.log('validando telefono');
                    console.log((telefonoCompleto.length > 0 && telefonoReg.test( telefonoCompleto )));
                    return (telefonoCompleto.length > 0 && telefonoReg.test( telefonoCompleto ));
                }
            };
            function loadModelo(index){
