<apex:page standardController="Reserva__c" extensions="NAV_TicketPDFController" standardstylesheets="false" showheader="false" renderAs="PDF" sidebar="false" applyBodyTag="false" applyHtmlTag="false">
<head>
    <title>Ticket</title>
    <style type="text/css">
        @page {
            border: 0px;
            size: 77mm 127mm;
            margin-top: 1mm;
            margin-left: 0.1mm;
            margin-right: 0.1mm;
            margin-bottom: 0.3mm;
        }
        * {
            font-family: "SansSerif";
            font-size: 6pt;
        }
        .idPagina {
            text-align: right;
            padding-right: 10px;
            padding-top: 5px;
        }
        .logo {
            text-align: center;
        }
        .allBorders {
            border: 1px solid black;
        }
        .titulo {
            font-size: 9pt;
        }
        .big {
            font-size: 8pt;
        }
        .fono {
            font-size: 7pt;
        }
        .direccion {
            font-size: 7pt;
        }
        .titulo-nb {
            padding-left: 3px;
            vertical-align: middle;
        }
        .extraLeft {
            padding-left: 3px;
        }
        .left {
            vertical-align: bottom;
            text-align: left;
        }
        .codigoRuta {
            font-family: "Arial Unicode MS";
            font-size: 10pt;
            font-weight: bold;
        }
        .space {
            margin-top: 5px;
            margin-bottom: 5px;
        }
        .blank-space, .blank-space td{
            line-height: 5px;
        }
        .titulo-seccion {
            line-height: 25px;
            font-weight: bold;
        }
        .tituloBold {
            padding-left: 3px;
            font-weight: bold;
        }
        .val-nb {
            line-height: 15px;
            display: block;
        }
        .valBold {
            font-weight: bold;
            line-height: 15px;
        }
        .top {
            vertical-align: top;
        }
        .middle {
            vertical-align: middle;
            text-align: center;
        }
        .servicio {
            padding-left: 3px;
            text-justify: auto;
            padding-right: 3px;
        }
        .thanks {
            text-align: center;
            line-height: 44px;
        }
    </style>
</head>
<body>
    <apex:variable value="{!1}" var="numRows" />
    <apex:repeat var="ticket" value="{!tickets}">
