                                <span class="titulo">{!ticket.titulo}</span><br />
                                <span class="fono">{!ticket.telefono}</span><br />
                                <span class="direccion">{!ticket.direccion}</span>
                            </td>
                        </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td width="60%" class="left">
                        <table width="100%" cellpadding="0" cellspacing="0">
