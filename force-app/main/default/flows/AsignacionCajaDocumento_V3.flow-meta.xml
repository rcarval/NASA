<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Si no existe una caja abierta para el día de hoy, crea una, si no, no pasa nada.</description>
        <name>ExisteCajaAbierta</name>
        <label>¿Existe una caja abierta para este usuario hoy?</label>
        <locationX>681</locationX>
        <locationY>726</locationY>
        <defaultConnector>
            <targetReference>AsignarCajaDocumento</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Si</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Caja</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Crear_Caja_al_usuario</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <formulas>
        <description>se concatena el nombre del usuario con la fecha de hoy</description>
        <name>NombreCaja</name>
        <dataType>String</dataType>
        <expression>LEFT({!$User.FirstName},1)+LEFT({!$User.LastName},1)+&quot;-&quot;+TEXT({!$Flow.CurrentDateTime})+&quot;-&quot;+TEXT({!NumeroCaja})</expression>
    </formulas>
    <formulas>
        <description>Número de la caja al momento de crearce</description>
        <name>NumeroCaja</name>
        <dataType>Number</dataType>
        <expression>{!$User.Correlativo_ultima_caja__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Asignacion Caja a Documento V3 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Asignacion Caja a Documento V3</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Se le crea la caja al usuario</description>
        <name>Crear_Caja_al_usuario</name>
        <label>Crear Caja al usuario</label>
        <locationX>488</locationX>
        <locationY>684</locationY>
        <connector>
            <targetReference>ActualizarCorrelativoUsuario</targetReference>
        </connector>
        <inputAssignments>
            <field>Estado_de_la_Caja__c</field>
            <value>
                <stringValue>Abierta</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>NombreCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Numero_de_Caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Buscar si existe una caja con ese nombre</description>
        <name>Buscar_Caja</name>
        <label>Buscar Caja</label>
        <locationX>584</locationX>
        <locationY>383</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ExisteCajaAbierta</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CreatedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CreatedById</elementReference>
            </value>
        </filters>
        <filters>
            <field>FechaCaja__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Fecha_Emision__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Estado_de_la_Caja__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Abierta</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Actualizar el correlativo ultima caja en el usuario</description>
        <name>ActualizarCorrelativoUsuario</name>
        <label>Actualizar Correlativo Usuario</label>
        <locationX>333</locationX>
        <locationY>577</locationY>
        <connector>
            <targetReference>Buscar_Caja</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Correlativo_ultima_caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <object>User</object>
    </recordUpdates>
    <recordUpdates>
        <description>Se asigna la caja al documento recién creado</description>
        <name>AsignarCajaDocumento</name>
        <label>Asignar Caja a Documento</label>
        <locationX>857</locationX>
        <locationY>602</locationY>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Buscar_Caja.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Buscar_Caja</targetReference>
        </connector>
        <object>Documento__c</object>
