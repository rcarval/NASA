<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Cuando sea Factura de Subsidio y cambien las fechas de Emisión o Vencimiento, se ajuste la fecha en formato numero para bSale</description>
        <name>Es_Factura_de_Subsidio</name>
        <label>Es Factura de Subsidio?</label>
        <locationX>182</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>No es de Subsidio</defaultConnectorLabel>
        <rules>
            <name>Si_es_de_Subsidio</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Factura_Subsidio</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actualiza_Fecha_de_Emision</targetReference>
            </connector>
            <label>Sí es de Subsidio</label>
        </rules>
    </decisions>
    <description>Recalcula Fechas Numéricas que requiere integración con bSale</description>
    <environments>Default</environments>
    <formulas>
        <name>FechaNumEmision</name>
        <dataType>Number</dataType>
        <expression>(DATETIMEVALUE(TEXT({!$Record.Fecha_Emision__c})&amp;&quot; 00:00:00&quot;)-DATETIMEVALUE(&quot;1970-01-01 00:00:00&quot;))*86400</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FechaNumVencimiento</name>
        <dataType>Number</dataType>
        <expression>(DATETIMEVALUE(TEXT({!$Record.Fecha_Vencimiento__c})&amp;&quot; 00:00:00&quot;)-DATETIMEVALUE(&quot;1970-01-01 00:00:00&quot;))*86400</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>ActualizaFechasEmiVencNumDocumentoFacturaSubsidio {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ActualizaFechasEmiVencNumDocumentoFacturaSubsidio</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Actuliza fecha en formato número</description>
        <name>Actualiza_Fecha_de_Emision</name>
        <label>Actualiza Fecha de Emisión</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Actualiza_Fecha_de_Vencimiento_numero</targetReference>
        </connector>
        <inputAssignments>
            <field>Fecha_de_Emision__c</field>
            <value>
                <elementReference>FechaNumEmision</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Actualiza_Fecha_de_Vencimiento_numero</name>
        <label>Actualiza Fecha de Vencimiento numero</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <inputAssignments>
            <field>Fecha_de_Vencimiento__c</field>
            <value>
                <elementReference>FechaNumVencimiento</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Es_Factura_de_Subsidio</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Fecha_Emision__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Fecha_Vencimiento__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Documento__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
