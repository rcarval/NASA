    <decisions>
        <description>Se evalúa si la acreditación tiene los datos del cliente confirmados o si el tipo de documentos es factura</description>
        <name>BoletaOFactura</name>
        <label>Boleta O Factura?</label>
        <locationX>314</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>No corre</defaultConnectorLabel>
        <rules>
            <name>FacturaPATH</name>
            <conditionLogic>1 AND (2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>getRecord.DatosConfirmados__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRecord.Documentos_a_emitir__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Factura mixta</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRecord.Documentos_a_emitir__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Facturas separadas</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRecord.Reserva__r.Estado_de_Reserva__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reservada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ConfirmacionDatosFactura</targetReference>
            </connector>
            <label>Factura</label>
        </rules>
        <rules>
            <name>BoletaPATH</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getRecord.DatosConfirmados__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRecord.Documentos_a_emitir__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sin documentos</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getRecord.Reserva__r.Estado_de_Reserva__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reservada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ConfirmacionDatosBoleta</targetReference>
            </connector>
            <label>Boleta</label>
        </rules>
    </decisions>
