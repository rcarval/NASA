<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Bloqueo_de_proceso_de_venta</name>
        <label>¿Bloqueo de proceso de venta?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Actualiza_Fecha_Desbloqueo</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Desbloqueado</defaultConnectorLabel>
        <rules>
            <name>Bloqueado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Bloqueo_proceso_venta__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actualiza_Fecha_Bloqueo</targetReference>
            </connector>
            <label>Bloqueado</label>
        </rules>
    </decisions>
    <description>Actualiza la fecha de Bloqueo y Desbloqueo cuando el usuario de recaudaciones marca o desmarca el Bloqueo de la caja</description>
    <environments>Default</environments>
    <formulas>
        <description>Retorna la fecha/hora actual</description>
        <name>VarD_now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Caja: Bloqueo/Desbloqueo de Ventas {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Caja: Bloqueo/Desbloqueo de Ventas</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
