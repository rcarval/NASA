        <name>Crear_Nombre_de_Caja</name>
        <label>Crear Nombre de Caja</label>
        <locationX>566</locationX>
        <locationY>433</locationY>
        <assignmentItems>
            <assignToReference>Nombre_de_la_Caja</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Concatenar_nombre</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Buscar_Caja</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Si existe la caja, asociar la forma de pago a esta, si no, crear una</description>
        <name>Existe_una_caja_para_este_usuario_hoy</name>
        <label>¿Existe una caja para este usuario hoy?</label>
        <locationX>641</locationX>
        <locationY>636</locationY>
        <defaultConnector>
            <targetReference>Crear_Caja_al_usuario</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SI</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Caja</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Asignar_Caja_a_FP</targetReference>
            </connector>
            <label>SI</label>
        </rules>
    </decisions>
    <description>Flujo que crea las cajas de los usuarios y asocia las formas de pago a esta</description>
    <formulas>
        <description>se concatena el nombre del usuario con la fecha de hoy</description>
        <name>Concatenar_nombre</name>
        <dataType>String</dataType>
        <expression>{!$User.Alias}+&quot;-&quot;+TEXT({!$Flow.CurrentDate})+&quot;Prueba&quot;</expression>
    </formulas>
    <interviewLabel>Flujo de Caja {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flujo de Caja</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Se le crea la caja al usuario</description>
        <name>Crear_Caja_al_usuario</name>
        <label>Crear Caja al usuario</label>
        <locationX>1035</locationX>
        <locationY>607</locationY>
        <connector>
            <targetReference>Buscar_Caja</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Nombre_de_la_Caja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Id_del_usuario</elementReference>
            </value>
        </inputAssignments>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Buscar si existe una caja con ese nombre</description>
        <name>Buscar_Caja</name>
        <label>Buscar Caja</label>
        <locationX>784</locationX>
        <locationY>407</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Existe_una_caja_para_este_usuario_hoy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Nombre_de_la_Caja</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
