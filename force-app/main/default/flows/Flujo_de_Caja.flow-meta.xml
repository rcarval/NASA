            <value>
                <elementReference>Buscar_Caja.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Asignar la caja correspondiente a la reserva de la forma de pago</description>
        <name>Asignar_Caja_a_Reserva</name>
        <label>Asignar Caja a Reserva</label>
        <locationX>62</locationX>
        <locationY>685</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Acreditacion__r.Reserva__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Buscar_Caja.Id</elementReference>
            </value>
        </inputAssignments>
