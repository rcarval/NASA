<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Pega cantidad de Documentos y Documentos listos para SAP a medida que cambian esos valores.</description>
    <environments>Default</environments>
    <formulas>
        <name>ValoresCantDocumentos</name>
        <dataType>String</dataType>
        <expression>&quot;D:&quot;&amp; TEXT({!$Record.Numero_Documentos__c})&amp;&quot; DS:&quot;&amp;TEXT({!$Record.Numero_Documentos_Listos_para_SAP__c})</expression>
    </formulas>
    <interviewLabel>Seguimiento Conteo Gatillador SAP {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Seguimiento Conteo Gatillador SAP</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Pega valores de conteo de documentos</description>
        <name>Actualiza_evidencia</name>
        <label>Actualiza evidencia</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <inputAssignments>
            <field>Seguimiento__c</field>
            <value>
                <elementReference>ValoresCantDocumentos</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Actualiza_evidencia</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Numero_Documentos__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Numero_Documentos_Listos_para_SAP__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Acreditacion__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
