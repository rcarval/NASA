    <decisions>
        <description>Se revisa si el estado de la caja cambió a &quot;Cerrada&quot;</description>
        <name>CerroCaja</name>
        <label>¿Se cerró la caja?</label>
        <locationX>574</locationX>
        <locationY>337</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Si</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Estado_de_la_Caja__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cerrada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ActualizarVariablesCierre</targetReference>
            </connector>
            <label>Si</label>
        </rules>
    </decisions>
