    <description>Flujo que asigna caja para documentos creados por facturacion manual</description>
    <environments>Default</environments>
    <formulas>
        <description>se concatena el nombre del usuario con la fecha de hoy</description>
        <name>NombreCaja</name>
        <dataType>String</dataType>
        <expression>LEFT({!$User.FirstName},1)+LEFT({!$User.LastName},1)+&quot;-&quot;+TEXT({!$Flow.CurrentDateTime})+&quot;-&quot;+TEXT({!NumeroCaja})</expression>
    </formulas>
    <formulas>
        <description>Número de la caja al momento de crearce</description>
        <name>NumeroCaja</name>
        <dataType>Number</dataType>
        <expression>{!$User.Correlativo_ultima_caja__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Asignacion Caja Facturacion Manual {!$Flow.CurrentDateTime}</interviewLabel>
