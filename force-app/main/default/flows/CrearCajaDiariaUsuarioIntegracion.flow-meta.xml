<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Se crea una caja diariamente a las 00:00 para el usuario integración</description>
    <environments>Default</environments>
    <formulas>
        <description>se concatena el nombre del usuario con la fecha de hoy</description>
        <name>NombreCaja</name>
        <dataType>String</dataType>
        <expression>LEFT({!ObtenerUsuarioIntegracion.FirstName},1)+LEFT({!ObtenerUsuarioIntegracion.LastName},1)+&quot;-&quot;+TEXT({!$Flow.CurrentDateTime})+&quot;-&quot;+TEXT({!NumeroCaja})</expression>
    </formulas>
    <formulas>
        <description>Número de la caja al momento de crearce</description>
        <name>NumeroCaja</name>
        <dataType>Number</dataType>
        <expression>{!ObtenerUsuarioIntegracion.Correlativo_ultima_caja__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Crear Caja Diaria Usuario Integración {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Crear Caja Diaria Usuario Integracion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Se le crea la caja al usuario</description>
        <name>CrearCajaUsuarioIntegracion</name>
        <label>CrearCajaUsuarioIntegracion</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>ActualizarCorrelativoUsuario</targetReference>
        </connector>
        <inputAssignments>
            <field>Estado_de_la_Caja__c</field>
            <value>
                <stringValue>Abierta</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>NombreCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Numero_de_Caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>ObtenerUsuarioIntegracion.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>ObtenerUsuarioIntegracion</name>
        <label>Obtener Usuario Integracion</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CrearCajaUsuarioIntegracion</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Usuario Integracion</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Usuario Integracion</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Actualizar el correlativo ultima caja en el usuario</description>
        <name>ActualizarCorrelativoUsuario</name>
        <label>ActualizarCorrelativoUsuario</label>
        <locationX>176</locationX>
        <locationY>516</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ObtenerUsuarioIntegracion.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Correlativo_ultima_caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <object>User</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ObtenerUsuarioIntegracion</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2022-09-27</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
