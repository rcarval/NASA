<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Si no existe una caja abierta para el día de hoy, crea una, si no, no pasa nada.</description>
        <name>ExisteCajaAbierta</name>
        <label>¿Existe una caja abierta para este usuario hoy?</label>
        <locationX>643</locationX>
        <locationY>616</locationY>
        <defaultConnector>
            <targetReference>AsignarCajaAC</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Si</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Caja</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Crear_Caja_al_usuario</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>Flujo que crea las cajas automáticamente para los usuarios cuando crear una acreditación</description>
    <environments>Default</environments>
    <formulas>
        <description>se concatena el nombre del usuario con la fecha de hoy</description>
        <name>NombreCaja</name>
        <dataType>String</dataType>
        <expression>LEFT({!$User.FirstName},1)+LEFT({!$User.LastName},1)+&quot;-&quot;+TEXT({!$Flow.CurrentDateTime})+&quot;-&quot;+TEXT({!NumeroCaja})</expression>
    </formulas>
    <formulas>
        <description>Número de la caja al momento de crearce</description>
        <name>NumeroCaja</name>
        <dataType>Number</dataType>
        <expression>{!$User.Correlativo_ultima_caja__c}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Crear Caja Acreditación {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Crear Caja Acreditación</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Se le crea la caja al usuario</description>
        <name>Crear_Caja_al_usuario</name>
        <label>Crear Caja al usuario</label>
        <locationX>839</locationX>
        <locationY>850</locationY>
        <connector>
            <targetReference>ActualizarCorrelativoUsuario</targetReference>
        </connector>
        <inputAssignments>
            <field>Estado_de_la_Caja__c</field>
            <value>
                <stringValue>Abierta</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>NombreCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Numero_de_Caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Caja__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Buscar si existe una caja con ese nombre. ORDER BY para consistencia en caso de duplicados</description>
        <name>Buscar_Caja</name>
        <label>Buscar Caja</label>
        <locationX>618</locationX>
        <locationY>415</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ExisteCajaAbierta</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FechaCaja__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FechaCreacion__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Estado_de_la_Caja__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Abierta</stringValue>
            </value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CreatedById</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Caja__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Actualizar el correlativo ultima caja en el usuario</description>
        <name>ActualizarCorrelativoUsuario</name>
        <label>Actualizar Correlativo Usuario</label>
        <locationX>635</locationX>
        <locationY>850</locationY>
        <connector>
            <targetReference>AsignarCajaAC_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Correlativo_ultima_caja__c</field>
            <value>
                <elementReference>NumeroCaja</elementReference>
            </value>
        </inputAssignments>
        <object>User</object>
    </recordUpdates>
    <recordUpdates>
        <description>Se asigna la caja a la Acreditación recién creada</description>
        <name>AsignarCajaAC</name>
        <label>Asignar Caja a AC</label>
        <locationX>395</locationX>
        <locationY>625</locationY>
        <connector>
            <targetReference>AsignarCajaReserva</targetReference>
        </connector>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Buscar_Caja.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Se asigna la caja a la Acreditación recién creada</description>
        <name>AsignarCajaAC_0</name>
        <label>Asignar Caja a AC</label>
        <locationX>416</locationX>
        <locationY>850</locationY>
        <connector>
            <targetReference>AsignarCajaReserva_0</targetReference>
        </connector>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Crear_Caja_al_usuario</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Asignar la caja correspondiente a la reserva de la Acreditación</description>
        <name>AsignarCajaReserva</name>
        <label>Asignar Caja a Reserva</label>
        <locationX>196</locationX>
        <locationY>625</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Reserva__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Buscar_Caja.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Reserva__c</object>
    </recordUpdates>
    <recordUpdates>
        <description>Asignar la caja correspondiente a la reserva de la Acreditación</description>
        <name>AsignarCajaReserva_0</name>
        <label>Asignar Caja a Reserva</label>
        <locationX>179</locationX>
        <locationY>849</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Reserva__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Caja__c</field>
            <value>
                <elementReference>Crear_Caja_al_usuario</elementReference>
            </value>
        </inputAssignments>
        <object>Reserva__c</object>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Buscar_Caja</targetReference>
        </connector>
        <object>Acreditacion__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
