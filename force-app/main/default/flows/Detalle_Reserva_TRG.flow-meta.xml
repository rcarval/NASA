    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Decide si tarificar a traves de la clase Apex o marcar la casilla &quot;Tarificar&quot; del registro de detalle de reserva para su posterior tarificación.</description>
        <name>EstablecerTarificacion</name>
        <label>EstablecerTarificacion</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Resultado predeterminado</defaultConnectorLabel>
        <rules>
            <name>Tarifica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Tarificar__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tarificar</targetReference>
            </connector>
            <label>Tarifica</label>
        </rules>
    </decisions>
