<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Cuando Crean la acreditación y seleccionan Destinatario de Documentos, Sus datos se copian en campos específicos.</description>
    <environments>Default</environments>
    <interviewLabel>Copia Datos Destinatario documentos {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Copia Datos Destinatario documentos</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Pega los datos del Destinatario de documentos en Campos de la sección &quot;Datos del Destinatario de Documentos&quot;</description>
        <name>CompletaDatosDestinatarioSeleccionado</name>
        <label>CompletaDatosDestinatarioSeleccionado</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <inputAssignments>
            <field>CiudadCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.BillingCity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ComunaCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.BillingState</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CorreoCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.PersonEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DireccionCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.BillingStreet</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>GiroCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.Giro__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RazonSocial__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.Razon_Social__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RutCliente__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.Identificacion__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TipoIdentificacion__c</field>
            <value>
                <elementReference>$Record.Destinatario_documentos__r.Tipo_de_identificacion__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CompletaDatosDestinatarioSeleccionado</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Destinatario_documentos__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Acreditacion__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
